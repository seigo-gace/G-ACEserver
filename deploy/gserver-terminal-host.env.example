# Copy outside the public repository to:
#   /home/gace/.config/gserver-terminal-host/env
# Store key material in the referenced mode-0600 files; never place it here.
GACE_GSERVER_HOST_HMAC_KEY_FILE=/home/gace/.config/gserver-terminal-host/request-hmac
GACE_GSERVER_RESULT_HMAC_KEY_FILE=/home/gace/.config/gserver-terminal-host/result-hmac
GACE_GSERVER_RESULT_ENDPOINT=https://replace-with-existing-private-route.example/internal/gserver-bounded-result
