[Unit]
Description=Gserver adapter for the shared server-core ServerTerminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/gace/Project/Gserver/repository
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/home/gace
Environment=PATH=/home/gace/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GSERVER_TERMINAL_COMMAND_TIMEOUT_SECONDS=3600
EnvironmentFile=/home/gace/.config/gserver-terminal-host/env
ExecStart=/usr/bin/python3 /home/gace/Project/Gserver/repository/scripts/gserver_terminal_host.py --host 127.0.0.1 --port 8790 --server-core /home/gace/server-core --result-endpoint ${GACE_GSERVER_RESULT_ENDPOINT}
Restart=on-failure
RestartSec=5
# Deliberately run with the same authority as the logged-in gace user.  The
# common Terminal must be able to edit owned repositories, use Git/SSH and run
# Docker/Compose without creating a separate privileged daemon.  Authentication,
# target/SHA binding and durable replay protection remain in the shared route.
UMask=0077

[Install]
WantedBy=default.target
